OPENAI_API_KEY=sk-your-key-here
# To use Grok instead, set AI_PROVIDER=xai and provide GROK_API_KEY.
AI_PROVIDER=openai
GROK_API_KEY=xai-your-key-here
AI_MODEL=gpt-4o-2024-08-06

# Voice pipeline configuration
VOICE_PROVIDER=local
# Local voice uses faster-whisper for speech recognition and pyttsx3 for speech.
# Set LOCAL_WHISPER_DEVICE=cuda only when faster-whisper/CUDA is configured.
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=auto
LOCAL_TTS_RATE=155
# For Bhashini, set these values and use VOICE_PROVIDER=bhashini.
BHASHINI_API_KEY=your-bhashini-key
BHASHINI_ASR_URL=https://your-bhashini-asr-url
BHASHINI_TTS_URL=https://your-bhashini-tts-url
BHASHINI_USER_ID=your-bhashini-user-id
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=sage

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# service_role key bypasses Row Level Security entirely — required by the
# backend (see supabase_schema.sql), but NEVER expose this to a frontend
# or commit it anywhere. Get it from Supabase Dashboard -> Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
